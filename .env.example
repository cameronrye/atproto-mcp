# AT Protocol MCP Server — Environment Configuration
#
# Copy this file to `.env` and fill in values. When you launch the server via
# the `atproto-mcp` CLI, a `.env` file in the current working directory is loaded
# automatically (real environment variables take precedence over `.env`).
#
# 🔓 The server works out-of-the-box WITHOUT any authentication. Everything below
# is optional. Only the variables listed here are actually read by the server.

# --- General -----------------------------------------------------------------

# Node environment. In "development", error messages returned to clients are more
# detailed; in "production" they are sanitized.
NODE_ENV=production

# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- AT Protocol service -----------------------------------------------------

# AT Protocol service (PDS/AppView) URL. Defaults to https://bsky.social.
# ATPROTO_SERVICE=https://bsky.social

# --- Authentication (optional) -----------------------------------------------
# App passwords are the recommended, fully-working authentication method.
# Enables write operations, feeds, notifications, follower lists, etc.
# ATPROTO_AUTH_METHOD=app-password
# ATPROTO_IDENTIFIER=your.handle.bsky.social
# ATPROTO_PASSWORD=your-app-password-here

# OAuth (EXPERIMENTAL — token exchange is not implemented yet, so OAuth cannot
# complete a login. Prefer app passwords above.) Only clientId is required for
# AT Protocol public clients; clientSecret is optional. The legacy OAUTH_CLIENT_ID
# / OAUTH_CLIENT_SECRET / OAUTH_REDIRECT_URI names are also accepted.
# ATPROTO_AUTH_METHOD=oauth
# ATPROTO_CLIENT_ID=your-oauth-client-id
# ATPROTO_CLIENT_SECRET=your-oauth-client-secret
# ATPROTO_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# --- Optional tuning ---------------------------------------------------------

# Override the MCP server name advertised to clients.
# MCP_SERVER_NAME=atproto-mcp

# Base directory used to resolve local file paths for media uploads.
# Defaults to the process working directory.
# ATPROTO_MEDIA_DIR=/path/to/allowed/media

# Firehose relay websocket URL (EXPERIMENTAL streaming; frame decoding is not yet
# implemented). Defaults to wss://bsky.network.
# ATPROTO_RELAY=wss://bsky.network

# NOTE: This server speaks MCP over stdio and does NOT listen on a TCP port.
# There are intentionally no PORT/HOST/Redis/Prometheus/Grafana settings here —
# earlier versions of this file documented variables the server never read.
