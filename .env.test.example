# AT Protocol MCP Server - Integration Test Configuration
# Copy this file to .env.test and fill in your test account credentials
#
# IMPORTANT: .env.test is in .gitignore and will NOT be committed to git
# This keeps your test account credentials secure

# Enable integration tests
RUN_INTEGRATION_TESTS=true

# Test Account Configuration
# Create a dedicated test account on Bluesky for integration testing
# Example: atproto-mcp-test.bsky.social
ATPROTO_TEST_IDENTIFIER=atproto-mcp-test.bsky.social
ATPROTO_TEST_PASSWORD=xxxx-xxxx-xxxx-xxxx

# AT Protocol Service (default: bsky.social)
ATPROTO_TEST_SERVICE=https://bsky.social

# Test Configuration
# Increase delays if you hit rate limits
TEST_RATE_LIMIT_DELAY=2000
TEST_REQUEST_TIMEOUT=60000

# Logging Level for Tests (debug, info, warn, error)
LOG_LEVEL=info

# Test Data Cleanup
# Set to true to automatically clean up test data after each test run
# Set to false to keep test data for debugging
TEST_CLEANUP_ENABLED=true

# Test Account Safety
# These settings help prevent accidental damage to the test account
TEST_MAX_POSTS_PER_RUN=10
TEST_MAX_FOLLOWS_PER_RUN=5
TEST_MAX_LIKES_PER_RUN=10

# Known Test Accounts (for testing interactions)
# These are public Bluesky accounts used for read-only testing
TEST_PUBLIC_ACCOUNT_1=bsky.app
TEST_PUBLIC_ACCOUNT_2=jay.bsky.team
TEST_PUBLIC_DID=did:plc:z72i7hdynmk6r22z27h6tvur

# Feature Flags for Test Coverage
# Enable/disable specific test suites
TEST_WRITE_OPERATIONS=true
TEST_MEDIA_UPLOADS=true
TEST_BATCH_OPERATIONS=true
TEST_ANALYTICS=true
TEST_MODERATION=true
TEST_STREAMING=false

# CI/CD Configuration
# Set these in your CI/CD environment (GitHub Actions, etc.)
# CI=true
# GITHUB_ACTIONS=true

